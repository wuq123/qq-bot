# QQ 开放平台机器人凭据。
QQBOT_APP_ID=your_app_id
QQBOT_APP_SECRET=your_app_secret
# 统一应用配置文件路径；通常无需修改。
APP_CONFIG_PATH=config/app.yaml
# 初始所有者的 QQ 用户 ID，多个 ID 用英文逗号分隔。
BOT_OWNER_USER_IDS=user_id_1,user_id_2
# 部落冲突开发者 API Token，在官网 developer.clashofclans.com 申请。
COC_API_TOKEN=your_token
# DeepSeek API Key；模型参数在 config/app.yaml 的 llm 分区配置。
DEEPSEEK_API_KEY=your_deepseek_api_key
# 原星火 Spark Lite API Key（已停用；切回星火时取消注释）。
# LLM_API_KEY=your_spark_lite_api_password
# OneBot 11 访问令牌；连接参数在 config/app.yaml 的 onebot 分区配置。
ONEBOT_ACCESS_TOKEN=your_onebot_access_token
